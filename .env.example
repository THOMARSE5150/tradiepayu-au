# ── TradiePay AU — env var reference ─────────────────────────────────────────
# Copy to .env for local development.
# Set these in Railway project settings for production (build-time env vars).
# Vite bakes VITE_* vars into the bundle at build time — they must be set
# before `npm run build` runs, not at runtime.

# Email capture endpoint — routes blog rate-alert signups to the contact
# form worker's /rate-alerts handler (sends confirmation + admin notification).
# Worker: https://dash.cloudflare.com → Workers → tradiepay-contact-form
VITE_EMAIL_ENDPOINT=https://contact-form.tradiepayau.directory/rate-alerts
